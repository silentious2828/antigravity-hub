{
  "$schema": "https://app.kilo.ai/config.json",
  "snapshot": false,
  "mcp": {
    "nteract": {
      "type": "local",
      "command": ["npx", "-y", "@nteract/mcp-server"]
    },
    "jupyter": {
      "type": "local",
      "command": ["uvx", "mcp-jupyter"],
      "enabled": true
    },
    "stripe": {
      "type": "local",
      "command": ["npx", "-y", "@stripe/mcp-server"],
      "env": {
        "STRIPE_API_KEY": "env:STRIPE_SECRET_KEY"
      }
    }
  }
}