# --- Stripe (billing) ---
# Find in Dashboard > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret: Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Stripe Price IDs (create via the 3-step setup) ---
# Dashboard > Products > copy each price_ id
STRIPE_PRICE_STARTER=price_...          # QAFlow AI Starter   — $49/mo   (tier: starter)
STRIPE_PRICE_PRO=price_...              # QAFlow AI Pro       — $149/mo  (tier: pro)
STRIPE_PRICE_LAUNCH=price_...           # QAFlow AI Launch    — $79/mo   (tier: launch)

# --- AI Providers (primary + fallbacks) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
